# Copy to server/.env and fill in values before production deployment.
APP_SECRET=replace-with-a-random-secret-of-at-least-32-characters
GOOGLE_WEB_CLIENT_ID=your-web-oauth-client-id.apps.googleusercontent.com
LIVEKIT_PUBLIC_URL=wss://your-livekit-host.example.com
LIVEKIT_INTERNAL_URL=wss://your-livekit-host.example.com
LIVEKIT_API_KEY=replace-me
LIVEKIT_API_SECRET=replace-me
